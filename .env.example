# ── Qdrant ─────────────────────────────────────────────────────────────
# Zufälligen Wert eintragen (z. B. 32+ Zeichen). Wird NICHT nach draußen
# freigegeben – Qdrant bleibt im internen Docker-Netz.
QDRANT_API_KEY=bitte-durch-zufaelligen-wert-ersetzen

# ── Ollama ─────────────────────────────────────────────────────────────
# Native Installation (Windows, Default): Container erreichen Ollama über
# host.docker.internal. Für das Docker-Profil ("ollama-docker", späterer
# Linux-Server): OLLAMA_BASE_URL=http://ollama:11434 setzen.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Modelle – bei Wechsel EMBEDDING_DIMS mitprüfen (bge-m3=1024, nomic=768)!
CHAT_MODEL=qwen2.5:7b-instruct
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMS=1024

# ── Mem0 / MCP ──────────────────────────────────────────────────────────
COLLECTION_NAME=memories
MEM0_DEFAULT_USER_ID=default

# Host-Header-Check (DNS-Rebinding-Schutz) des mcp-SDK. Leer (Default) = Check
# aus – nötig für Betrieb hinter TLS-Proxies (Funnel/Caddy), sonst HTTP 421
# "Misdirected Request". Komma-getrennte Liste = Check aktiv, nur diese Hosts.
# Beispiel: MCP_ALLOWED_HOSTS=desktop-xxxx.tailxxxx.ts.net,localhost:*
MCP_ALLOWED_HOSTS=

# NUR für lokale Entwicklung (ohne Tokens) – niemals mit Funnel/Internet!
MCP_AUTH_DISABLED=false